{
  "seed": 42,
  "data": {
    "train_manifest": "data/processed/train.jsonl",
    "val_manifest": "data/processed/val.jsonl",
    "centers_path": "data/processed/cluster_centers.npz",
    "max_frames": 256,
    "min_frames": 12,
    "num_workers": 4
  },
  "model": {
    "d_model": 256,
    "n_heads": 8,
    "n_layers": 8,
    "ff_multiplier": 4,
    "dropout": 0.1,
    "max_frames": 256
  },
  "masking": {
    "mask_probability": 0.5,
    "mean_span_length": 10
  },
  "training": {
    "output_dir": "outputs/pretrain",
    "batch_size": 16,
    "epochs": 100,
    "learning_rate": 0.0003,
    "weight_decay": 0.01,
    "warmup_steps": 2000,
    "grad_clip": 1.0,
    "gradient_accumulation": 1,
    "amp": true,
    "log_every": 25,
    "save_every": 1
  }
}

