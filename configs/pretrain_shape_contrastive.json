{
  "seed": 42,
  "objective": {
    "name": "contrastive",
    "temperature": 0.1,
    "coordinate_jitter_std": 0.01,
    "landmark_dropout_probability": 0.05,
    "view_mask_probability": 0.2,
    "view_mean_span_length": 10
  },
  "data": {
    "train_archive": "data/raw/raw_keypoints_1.zip",
    "val_archive": "data/raw/raw_keypoints_1.zip",
    "train_annotations": "data/raw/YT.translations.train.json",
    "val_annotations": "data/raw/YT.translations.dev.json",
    "max_frames": 256,
    "num_workers": 2,
    "prefetch_factor": 2
  },
  "model": {
    "hidden_size": 256,
    "num_hidden_layers": 6,
    "num_attention_heads": 8,
    "intermediate_size": 1024,
    "hidden_dropout_prob": 0.1,
    "attention_probs_dropout_prob": 0.1,
    "max_frames": 256,
    "graph_channels": 48,
    "graph_layers": 2,
    "graph_temporal_kernel": 5,
    "architecture": "part_stgcn_temporal_bert"
  },
  "masking": {
    "mask_probability": 0.4,
    "mean_span_length": 20,
    "velocity_weight": 0.25
  },
  "training": {
    "output_dir": "outputs/pretrain_shape_contrastive",
    "batch_size": 16,
    "epochs": 1,
    "learning_rate": 0.0003,
    "weight_decay": 0.01,
    "warmup_steps": 1000,
    "scheduler_total_steps": 25000,
    "grad_clip": 1.0,
    "gradient_accumulation": 1,
    "amp": true,
    "progress_every": 1,
    "log_every": 25,
    "save_every": 0
  }
}
