{
  "seed": 42,
  "context_condition": "real",
  "context": {
    "block_frames": 16,
    "boundary_mask_frames": 1,
    "shuffle_seed": 42017,
    "strategy": "cross_sentence_fixed_local_trajectory_block_reassignment",
    "source_grouping": "structural_source_video_id_where_possible"
  },
  "objective": {
    "name": "masked_cluster",
    "codebook_path": "data/derived/spatial_shubert_codebooks.npz"
  },
  "data": {
    "train_archive": "data/raw/raw_keypoints_1.zip",
    "val_archive": "data/raw/raw_keypoints_1.zip",
    "train_annotations": "data/raw/YT.translations.train.json",
    "val_annotations": "data/raw/YT.translations.dev.json",
    "max_frames": 256,
    "num_workers": 2,
    "prefetch_factor": 2
  },
  "model": {
    "hidden_size": 256,
    "num_hidden_layers": 6,
    "num_attention_heads": 8,
    "intermediate_size": 1024,
    "hidden_dropout_prob": 0.1,
    "attention_probs_dropout_prob": 0.1,
    "max_frames": 256,
    "graph_channels": 48,
    "graph_layers": 2,
    "clusters_per_stream": 100,
    "architecture": "multistream_spatial_gcn_shubert"
  },
  "masking": {
    "mask_probability": 0.4,
    "mean_span_length": 20,
    "velocity_weight": 0.0
  },
  "training": {
    "output_dir": "outputs/pretrain_spatial_shubert_context/real",
    "batch_size": 16,
    "epochs": 1,
    "learning_rate": 0.0003,
    "weight_decay": 0.01,
    "warmup_steps": 1000,
    "scheduler_total_steps": 25000,
    "grad_clip": 1.0,
    "gradient_accumulation": 1,
    "amp": true,
    "progress_every": 1,
    "log_every": 25,
    "save_every": 0
  }
}
